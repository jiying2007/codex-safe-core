{
  "schemaVersion": 1,
  "maintenanceModel": "solo-maintainer",
  "repositories": [
    "codex-safe-core",
    "codex-review",
    "codex-commit",
    "codex-pr",
    "codex-review-service",
    "codex-diagnose",
    "codex-debug"
  ],
  "repositoryPolicies": {},
  "defaultRepositoryPolicy": {
    "protection": "native",
    "nativeRulesetRequired": true
  },
  "defaultBranch": "main",
  "rulesetName": "Codex Safe main protection",
  "enforcement": "active",
  "requiredRuleTypes": [
    "pull_request",
    "required_status_checks",
    "deletion",
    "non_fast_forward"
  ],
  "pullRequest": {
    "minimumApprovals": 0,
    "dismissStaleReviewsOnPush": false,
    "requireCodeOwnerReview": false,
    "requireLastPushApproval": false
  },
  "requiredStatusChecks": {
    "requireNonEmpty": true,
    "strictRequiredStatusChecksPolicy": true,
    "requireExactContexts": true,
    "contexts": [
      "CI Gate"
    ],
    "expectedSource": {
      "integrationId": 15368,
      "appSlug": "github-actions"
    },
    "requireSourceBinding": true
  },
  "maximumBypassActors": 1,
  "allowedBypassModes": [
    "pull_request"
  ],
  "deleteBranchOnMerge": true,
  "allowAutoMerge": false
}

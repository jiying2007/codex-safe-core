{
  "schemaVersion": 2,
  "core": {
    "forbiddenRuntimeDomains": ["gitlab", "scm-provider", "notification", "sqlite", "database", "pipeline-api"],
    "forbidRuntimeDependencies": true,
    "forbidBranchTrackingSubmodule": true,
    "forbidRepositoryDefinedAnalyzerCommands": true,
    "forbidRepositoryModelSelection": true,
    "forbidConcreteModelIdsInCoreRouting": true,
    "forbidImplicitNetworkRetrieval": true
  },
  "family": {
    "canonicalPolicyFile": ".codex-safe.json",
    "forbiddenLegacyPolicyFiles": [".codex-review.json", ".codex-commit.json", ".codex-pr.json", ".codex-change-safe.json"],
    "forbidCompatibilityProxy": true,
    "forbidUnpinnedActions": true,
    "forbidModelAutoCommitPushMerge": true,
    "forbidSelfTrainingFromFeedback": true,
    "forbidPrMrNarrativeGenerator": true,
    "changeDefaultModelCalls": 0,
    "singleFamilyManifest": true
  },
  "reviewService": {
    "productionPlatforms": ["linux"],
    "runnerTransport": "unix-domain-socket",
    "forbiddenCompatibilitySurfaces": ["named-pipe-runner", "legacy-policy", "branch-following-core", "shell-defined-analyzer-command"],
    "multiTenantIsolation": false
  },
  "diagnose": {
    "modelMayMutateRepository": false,
    "modelMayRetryPipeline": false,
    "modelMayCreateMergeRequest": false,
    "modelMayExecuteFailureLogInstructions": false,
    "pipelineLogsAreUntrustedEvidence": true
  },
  "debug": {
    "modelMayExecuteCommands": false,
    "modelMayAuthorizePatchApplication": false,
    "modelMayCommitPushMerge": false,
    "modelMayPromoteOwnHypothesisToConfirmed": false,
    "failureEvidenceIsUntrusted": true,
    "patchApplicationRequiresExplicitUserAuthority": true,
    "verificationRequiresObservedExecutionEvidence": true
  }
}
